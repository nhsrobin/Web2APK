# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_BUILD_TOKEN: (Optional) GitHub Personal Access Token to trigger background GitHub Actions APK compiler.
GITHUB_BUILD_TOKEN=""

# GITHUB_BUILD_REPO: (Optional) GitHub repo (e.g. username/web-to-apk-studio)
GITHUB_BUILD_REPO=""

# FIREBASE_PROJECT_ID: (Optional) Your Firebase Project ID for automated hosting deploy.
FIREBASE_PROJECT_ID=""
