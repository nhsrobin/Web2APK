# GEMINI_API_KEY: Optional if AI features are invoked.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_BUILD_TOKEN: GitHub Personal Access Token (classic with repo/workflow scope or fine-grained)
GITHUB_BUILD_TOKEN=

# GITHUB_BUILD_REPO: GitHub Repository in owner/repo format (e.g. username/Web2APK)
GITHUB_BUILD_REPO=
